# --- Telegram ---
BOT_TOKEN=123456:replace-me
BOT_USERNAME=studsovet_fund_bot
# Telegram ID владельцев через запятую (узнать свой ID: @userinfobot)
OWNER_TELEGRAM_IDS=111111111

# --- База данных ---
# Docker: пароль для контейнера PostgreSQL (DATABASE_URL задаётся в docker-compose.yml)
POSTGRES_PASSWORD=change-me-strong-password
# Vercel / без Docker: строка подключения. Для Supabase — «Session pooler» из Connect.
# DATABASE_URL=postgresql://postgres.<id>:<пароль>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Режим вебхука (Vercel) ---
# Случайные строки: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
CRON_SECRET=

# --- Платежи (Telegram Payments + ЮKassa) ---
# Токен из @BotFather → ваш бот → Bot Settings → Payments → ЮKassa.
# Сначала тестовый (вида 381764678:TEST:...), боевой (…:LIVE:…) — после проверки.
PAYMENT_PROVIDER_TOKEN=
# Включайте только после согласования схемы с вузом и ЮKassa (README, «Юридические ограничения»).
PAYMENTS_ENABLED=false

# Кому перечисляются средства — показывается перед оплатой и в счёте
RECIPIENT_NAME=Наименование получателя, ИНН
# Telegram не выставит счёт меньше своего минимума (около 1 $ в рублях)
MIN_AMOUNT_RUB=100
MAX_AMOUNT_RUB=100000
# Сколько часов неоплаченный счёт остаётся действительным
INVOICE_TTL_HOURS=24

# Чек по 54-ФЗ через ЮKassa (Telegram попросит e-mail плательщика)
RECEIPT_ENABLED=false
RECEIPT_VAT_CODE=1
RECEIPT_PAYMENT_SUBJECT=another
RECEIPT_PAYMENT_MODE=full_payment

# --- Напоминания ---
TIMEZONE=Europe/Moscow
REMINDER_HOUR=12
REMINDER_DAY=1

LOG_LEVEL=INFO
