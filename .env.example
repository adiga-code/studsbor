# --- Telegram ---
BOT_TOKEN=123456:replace-me
BOT_USERNAME=studsovet_fund_bot
# Telegram ID владельцев через запятую (узнать свой ID: @userinfobot)
OWNER_TELEGRAM_IDS=111111111

# --- База данных ---
POSTGRES_PASSWORD=change-me-strong-password
# Для запуска без Docker:
# DATABASE_URL=postgresql+asyncpg://studsbor:change-me@localhost:5432/studsbor

# --- Сервер ---
DOMAIN=fund.example.ru

# --- Платежи ЮKassa ---
# Включайте только после согласования схемы с вузом и ЮKassa (раздел README «Юридические ограничения»).
PAYMENTS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Случайная строка; URL для уведомлений: https://DOMAIN/yookassa/webhook/<секрет>
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_CHECK_IP=true
# Куда вернуть студента после оплаты (по умолчанию — в бота)
PAYMENT_RETURN_URL=

# Кому перечисляются средства — показывается перед оплатой
RECIPIENT_NAME=Наименование получателя, ИНН
MIN_AMOUNT_RUB=10
MAX_AMOUNT_RUB=100000

# --- Напоминания ---
TIMEZONE=Europe/Moscow
REMINDER_HOUR=12
REMINDER_DAY=1
PENDING_SYNC_MINUTES=10

LOG_LEVEL=INFO
